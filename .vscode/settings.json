{
  "markdown-pdf.styles": [
    "dokumen-serah-terima/format-akademik.css"
  ],
  "markdown-pdf.format": "A4",
  "markdown-pdf.orientation": "portrait",
  "markdown-pdf.margin.top": "4cm",
  "markdown-pdf.margin.left": "4cm",
  "markdown-pdf.margin.right": "3cm",
  "markdown-pdf.margin.bottom": "3cm",
  "markdown-pdf.displayHeaderFooter": true,
  "markdown-pdf.headerTemplate": "<span></span>",
  "markdown-pdf.footerTemplate": "<div style=\"width:100%;font-size:10pt;font-family:'Times New Roman',Times,serif;text-align:center;\"><span class='pageNumber'></span></div>",
  "markdown-pdf.breaks": false,
  "markdown-pdf.emoji": false
}
